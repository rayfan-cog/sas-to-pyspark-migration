 210       +
 211       +/* Step 1: Create derived columns using DATA step */
 212       +data work.home_equity_clean;
 213       +    length LOAN_OUTCOME $ 7;
 214       +    set work.home_equity;
 215       +
 216       +    /* Calculate Loan-to-Value ratio */
 217       +    if VALUE ne . and MORTDUE ne . and VALUE > 0 then
 218       +        LTV = MORTDUE / VALUE;
 219       +    else
 220       +        LTV = .;
 221       +
 222       +    /* Create descriptive loan outcome */
 223       +    if BAD = 0 then LOAN_OUTCOME = 'Paid';
 224       +    else if BAD = 1 then LOAN_OUTCOME = 'Default';
 225       +    else LOAN_OUTCOME = '';
 226       +
 227       +    /* Proper-case city names */
 228       +    CITY = propcase(CITY);
 229       +
 230       +    /* Apply labels */
 231       +    label LTV = "Loan to Value Ratio"
 232       +          LOAN_OUTCOME = "Loan Outcome";
 233       +    format LTV percent8.2;
