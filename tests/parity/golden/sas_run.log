 1901      +/* Step 2: Create risk segment variables */
 1902      +data work.home_equity_risk;
 1903      +    set work.home_equity_final;
 1904      +
 1905      +    /* LTV risk category */
 1906      +    length LTV_RISK_CAT $6 DTI_RISK_CAT $9 DELINQ_RISK_CAT $6;
 1907      +
 1908      +    if LTV ne . then do;
 1909      +        if LTV < 0.60 then LTV_RISK_CAT = 'Low';
 1910      +        else if LTV < 0.80 then LTV_RISK_CAT = 'Medium';
 1911      +        else LTV_RISK_CAT = 'High';
 1912      +    end;
 1913      +
 1914      +    /* Debt-to-Income risk category */
 1915      +    if DEBTINC ne . then do;
 1916      +        if DEBTINC < 30 then DTI_RISK_CAT = 'Low';
 1917      +        else if DEBTINC < 40 then DTI_RISK_CAT = 'Medium';
 1918      +        else if DEBTINC < 50 then DTI_RISK_CAT = 'High';
 1919      +        else DTI_RISK_CAT = 'Very High';
 1920      +    end;
 1921      +
 1922      +    /* Delinquency risk category */
 1923      +    if DELINQ ne . then do;
 1924      +        if DELINQ = 0 then DELINQ_RISK_CAT = 'None';
 1925      +        else if DELINQ = 1 then DELINQ_RISK_CAT = 'Low';
 1926      +        else if DELINQ <= 3 then DELINQ_RISK_CAT = 'Medium';
 1927      +        else DELINQ_RISK_CAT = 'High';
 1928      +    end;
 1929      +
 1930      +    /* Composite risk score (0-10 scale) */
 1931      +    RISK_SCORE = 0;
 1932      +
 1933      +    /* LTV component (0-3 points) */
 1934      +    if LTV ne . then do;
 1935      +        if LTV >= 0.80 then RISK_SCORE = RISK_SCORE + 3;
 1936      +        else if LTV >= 0.60 then RISK_SCORE = RISK_SCORE + 1.5;
 1937      +    end;
 1938      +
 1939      +    /* DTI component (0-3 points) */
 1940      +    if DEBTINC ne . then do;
 1941      +        if DEBTINC >= 50 then RISK_SCORE = RISK_SCORE + 3;
 1942      +        else if DEBTINC >= 40 then RISK_SCORE = RISK_SCORE + 2;
 1943      +        else if DEBTINC >= 30 then RISK_SCORE = RISK_SCORE + 1;
 1944      +    end;
 1945      +
 1946      +    /* Delinquency component (0-2 points) */
 1947      +    if DELINQ ne . then do;
 1948      +        if DELINQ >= 4 then RISK_SCORE = RISK_SCORE + 2;
 1949      +        else if DELINQ >= 2 then RISK_SCORE = RISK_SCORE + 1.5;
 1950      +        else if DELINQ = 1 then RISK_SCORE = RISK_SCORE + 0.5;
 1951      +    end;
 1952      +
 1953      +    /* Derogatory reports component (0-2 points) */
 1954      +    if DEROG ne . then do;
 1955      +        if DEROG >= 3 then RISK_SCORE = RISK_SCORE + 2;
 1956      +        else if DEROG >= 1 then RISK_SCORE = RISK_SCORE + 1;
 1957      +    end;
 1958      +
 1959      +    /* Risk score category */
 1960      +    length RISK_SEGMENT $14;
 1961      +    if RISK_SCORE < 3 then RISK_SEGMENT = 'Low Risk';
 1962      +    else if RISK_SCORE < 5 then RISK_SEGMENT = 'Medium Risk';
 1963      +    else if RISK_SCORE < 7 then RISK_SEGMENT = 'High Risk';
 1964      +    else RISK_SEGMENT = 'Very High Risk';
 1965      +
 1966      +    label LTV_RISK_CAT = "LTV Risk Category"
 1967      +          DTI_RISK_CAT = "Debt-to-Income Risk Category"
 1968      +          DELINQ_RISK_CAT = "Delinquency Risk Category"
 1969      +          RISK_SCORE = "Composite Risk Score (0-10)"
 1970      +          RISK_SEGMENT = "Risk Segment";
 1971      +run;
 
