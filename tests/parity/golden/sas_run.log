 383       +
 384       +/* Step 2: Create risk segment variables */
 385       +data work.home_equity_risk;
 386       +    set work.home_equity_final;
 387       +
 388       +    /* LTV risk category */
 389       +    length LTV_RISK_CAT $6 DTI_RISK_CAT $9 DELINQ_RISK_CAT $6;
 390       +
 391       +    if LTV ne . then do;
 392       +        if LTV < 0.60 then LTV_RISK_CAT = 'Low';
 393       +        else if LTV < 0.80 then LTV_RISK_CAT = 'Medium';
 394       +        else LTV_RISK_CAT = 'High';
 395       +    end;
 396       +
 397       +    /* Debt-to-Income risk category */
 398       +    if DEBTINC ne . then do;
 399       +        if DEBTINC < 30 then DTI_RISK_CAT = 'Low';
 400       +        else if DEBTINC < 40 then DTI_RISK_CAT = 'Medium';
 401       +        else if DEBTINC < 50 then DTI_RISK_CAT = 'High';
 402       +        else DTI_RISK_CAT = 'Very High';
 403       +    end;
 404       +
 405       +    /* Delinquency risk category */
 406       +    if DELINQ ne . then do;
 407       +        if DELINQ = 0 then DELINQ_RISK_CAT = 'None';
 408       +        else if DELINQ = 1 then DELINQ_RISK_CAT = 'Low';
 409       +        else if DELINQ <= 3 then DELINQ_RISK_CAT = 'Medium';
 410       +        else DELINQ_RISK_CAT = 'High';
 411       +    end;
 412       +
 413       +    /* Composite risk score (0-10 scale) */
 414       +    RISK_SCORE = 0;
 415       +
 416       +    /* LTV component (0-3 points) */
 417       +    if LTV ne . then do;
 418       +        if LTV >= 0.80 then RISK_SCORE = RISK_SCORE + 3;
 419       +        else if LTV >= 0.60 then RISK_SCORE = RISK_SCORE + 1.5;
 420       +    end;
 421       +
 422       +    /* DTI component (0-3 points) */
 423       +    if DEBTINC ne . then do;
 424       +        if DEBTINC >= 50 then RISK_SCORE = RISK_SCORE + 3;
 425       +        else if DEBTINC >= 40 then RISK_SCORE = RISK_SCORE + 2;
 426       +        else if DEBTINC >= 30 then RISK_SCORE = RISK_SCORE + 1;
 427       +    end;
 428       +
 429       +    /* Delinquency component (0-2 points) */
 430       +    if DELINQ ne . then do;
 431       +        if DELINQ >= 4 then RISK_SCORE = RISK_SCORE + 2;
 432       +        else if DELINQ >= 2 then RISK_SCORE = RISK_SCORE + 1.5;
 433       +        else if DELINQ = 1 then RISK_SCORE = RISK_SCORE + 0.5;
 434       +    end;
 435       +
 436       +    /* Derogatory reports component (0-2 points) */
 437       +    if DEROG ne . then do;
 438       +        if DEROG >= 3 then RISK_SCORE = RISK_SCORE + 2;
 439       +        else if DEROG >= 1 then RISK_SCORE = RISK_SCORE + 1;
 440       +    end;
 441       +
 442       +    /* Risk score category */
 443       +    length RISK_SEGMENT $14;
 444       +    if RISK_SCORE < 3 then RISK_SEGMENT = 'Low Risk';
 445       +    else if RISK_SCORE < 5 then RISK_SEGMENT = 'Medium Risk';
 446       +    else if RISK_SCORE < 7 then RISK_SEGMENT = 'High Risk';
 447       +    else RISK_SEGMENT = 'Very High Risk';
 448       +
 449       +    label LTV_RISK_CAT = "LTV Risk Category"
 450       +          DTI_RISK_CAT = "Debt-to-Income Risk Category"
 451       +          DELINQ_RISK_CAT = "Delinquency Risk Category"
 452       +          RISK_SCORE = "Composite Risk Score (0-10)"
