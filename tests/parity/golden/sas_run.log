 346       +/*******************************************************************************/
 347       +/*  SAS Program: 04_risk_segmentation.sas                                    */
 348       +/*  Purpose: Create risk segments for loan portfolio analysis                */
 349       +/*  - Define risk buckets using PROC FORMAT                                  */
 350       +/*  - Create composite risk scores                                           */
 351       +/*  - Analyze default rates by risk segment                                  */
 352       +/*******************************************************************************/
 353       +
 354       +/* Step 1: Define risk bucket formats using PROC FORMAT */
 355       +proc format;
 356       +    /* LTV Risk Categories */
 357       +    value ltv_risk
 358       +        low  -< 0.60 = 'Low'
 359       +        0.60 -< 0.80 = 'Medium'
 360       +        0.80 - high   = 'High';
 NOTE: Format LTV_RISK has been output.
 361       +
 362       +    /* Debt-to-Income Risk Categories */
 363       +    value dti_risk
 364       +        low  -< 30  = 'Low'
 365       +        30   -< 40  = 'Medium'
 366       +        40   -< 50  = 'High'
 367       +        50   - high  = 'Very High';
 NOTE: Format DTI_RISK has been output.
 368       +
 369       +    /* Delinquency Risk Categories */
 370       +    value delinq_risk
 371       +        0         = 'None'
 372       +        1         = 'Low'
 373       +        2 - 3     = 'Medium'
 374       +        4 - high  = 'High';
 NOTE: Format DELINQ_RISK has been output.
 375       +
 376       +    /* Combined Risk Score Categories */
 377       +    value risk_score
 378       +        low  -< 3 = 'Low Risk'
