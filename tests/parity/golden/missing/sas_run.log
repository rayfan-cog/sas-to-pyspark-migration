 175       +/*******************************************************************************/
 176       +/*  SAS Program: 02_data_cleaning.sas                                        */
 177       +/*  Purpose: Clean and transform the HOME_EQUITY dataset                     */
 178       +/*  - Create derived columns (LTV, LOAN_OUTCOME)                            */
 179       +/*  - Handle missing values                                                  */
 180       +/*  - Filter records and check for outliers                                  */
 181       +/*******************************************************************************/
 182       +
 183       +/* Step 1: Create derived columns using DATA step */
 184       +data work.home_equity_clean;
 185       +    length LOAN_OUTCOME $ 7;
 186       +    set work.home_equity;
 187       +
 188       +    /* Calculate Loan-to-Value ratio */
 189       +    if VALUE ne . and MORTDUE ne . and VALUE > 0 then
 190       +        LTV = MORTDUE / VALUE;
 191       +    else
 192       +        LTV = .;
 193       +
 194       +    /* Create descriptive loan outcome */
 195       +    if BAD = 0 then LOAN_OUTCOME = 'Paid';
 196       +    else if BAD = 1 then LOAN_OUTCOME = 'Default';
 197       +    else LOAN_OUTCOME = '';
 198       +
 199       +    /* Proper-case city names */
 200       +    CITY = propcase(CITY);
 201       +
 202       +    /* Apply labels */
 203       +    label LTV = "Loan to Value Ratio"
 204       +          LOAN_OUTCOME = "Loan Outcome";
 205       +    format LTV percent8.2;
 206       +run;
 
