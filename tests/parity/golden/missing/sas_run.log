 355       +
 356       +/* Step 2: Create risk segment variables */
 357       +data work.home_equity_risk;
 358       +    set work.home_equity_final;
 359       +
 360       +    /* LTV risk category */
 361       +    length LTV_RISK_CAT $6 DTI_RISK_CAT $9 DELINQ_RISK_CAT $6;
 362       +
 363       +    if LTV ne . then do;
 364       +        if LTV < 0.60 then LTV_RISK_CAT = 'Low';
 365       +        else if LTV < 0.80 then LTV_RISK_CAT = 'Medium';
 366       +        else LTV_RISK_CAT = 'High';
 367       +    end;
 368       +
 369       +    /* Debt-to-Income risk category */
 370       +    if DEBTINC ne . then do;
 371       +        if DEBTINC < 30 then DTI_RISK_CAT = 'Low';
 372       +        else if DEBTINC < 40 then DTI_RISK_CAT = 'Medium';
 373       +        else if DEBTINC < 50 then DTI_RISK_CAT = 'High';
 374       +        else DTI_RISK_CAT = 'Very High';
 375       +    end;
 376       +
 377       +    /* Delinquency risk category */
 378       +    if DELINQ ne . then do;
 379       +        if DELINQ = 0 then DELINQ_RISK_CAT = 'None';
 380       +        else if DELINQ = 1 then DELINQ_RISK_CAT = 'Low';
 381       +        else if DELINQ <= 3 then DELINQ_RISK_CAT = 'Medium';
 382       +        else DELINQ_RISK_CAT = 'High';
 383       +    end;
 384       +
 385       +    /* Composite risk score (0-10 scale) */
 386       +    RISK_SCORE = 0;
 387       +
 388       +    /* LTV component (0-3 points) */
 389       +    if LTV ne . then do;
 390       +        if LTV >= 0.80 then RISK_SCORE = RISK_SCORE + 3;
 391       +        else if LTV >= 0.60 then RISK_SCORE = RISK_SCORE + 1.5;
 392       +    end;
 393       +
 394       +    /* DTI component (0-3 points) */
 395       +    if DEBTINC ne . then do;
 396       +        if DEBTINC >= 50 then RISK_SCORE = RISK_SCORE + 3;
 397       +        else if DEBTINC >= 40 then RISK_SCORE = RISK_SCORE + 2;
 398       +        else if DEBTINC >= 30 then RISK_SCORE = RISK_SCORE + 1;
 399       +    end;
 400       +
 401       +    /* Delinquency component (0-2 points) */
 402       +    if DELINQ ne . then do;
 403       +        if DELINQ >= 4 then RISK_SCORE = RISK_SCORE + 2;
 404       +        else if DELINQ >= 2 then RISK_SCORE = RISK_SCORE + 1.5;
 405       +        else if DELINQ = 1 then RISK_SCORE = RISK_SCORE + 0.5;
 406       +    end;
 407       +
 408       +    /* Derogatory reports component (0-2 points) */
 409       +    if DEROG ne . then do;
 410       +        if DEROG >= 3 then RISK_SCORE = RISK_SCORE + 2;
 411       +        else if DEROG >= 1 then RISK_SCORE = RISK_SCORE + 1;
 412       +    end;
 413       +
 414       +    /* Risk score category */
 415       +    length RISK_SEGMENT $14;
 416       +    if RISK_SCORE < 3 then RISK_SEGMENT = 'Low Risk';
 417       +    else if RISK_SCORE < 5 then RISK_SEGMENT = 'Medium Risk';
 418       +    else if RISK_SCORE < 7 then RISK_SEGMENT = 'High Risk';
 419       +    else RISK_SEGMENT = 'Very High Risk';
 420       +
 421       +    label LTV_RISK_CAT = "LTV Risk Category"
 422       +          DTI_RISK_CAT = "Debt-to-Income Risk Category"
 423       +          DELINQ_RISK_CAT = "Delinquency Risk Category"
 424       +          RISK_SCORE = "Composite Risk Score (0-10)"
 425       +          RISK_SEGMENT = "Risk Segment";
 426       +run;
 
