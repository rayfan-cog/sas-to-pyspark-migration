 318       +/*******************************************************************************/
 319       +/*  SAS Program: 04_risk_segmentation.sas                                    */
 320       +/*  Purpose: Create risk segments for loan portfolio analysis                */
 321       +/*  - Define risk buckets using PROC FORMAT                                  */
 322       +/*  - Create composite risk scores                                           */
 323       +/*  - Analyze default rates by risk segment                                  */
 324       +/*******************************************************************************/
 325       +
 326       +/* Step 1: Define risk bucket formats using PROC FORMAT */
 327       +proc format;
 328       +    /* LTV Risk Categories */
 329       +    value ltv_risk
 330       +        low  -< 0.60 = 'Low'
 331       +        0.60 -< 0.80 = 'Medium'
 332       +        0.80 - high   = 'High';
 NOTE: Format LTV_RISK has been output.
 333       +
 334       +    /* Debt-to-Income Risk Categories */
 335       +    value dti_risk
 336       +        low  -< 30  = 'Low'
 337       +        30   -< 40  = 'Medium'
 338       +        40   -< 50  = 'High'
 339       +        50   - high  = 'Very High';
 NOTE: Format DTI_RISK has been output.
 340       +
 341       +    /* Delinquency Risk Categories */
 342       +    value delinq_risk
 343       +        0         = 'None'
 344       +        1         = 'Low'
 345       +        2 - 3     = 'Medium'
 346       +        4 - high  = 'High';
 NOTE: Format DELINQ_RISK has been output.
 347       +
 348       +    /* Combined Risk Score Categories */
 349       +    value risk_score
 350       +        low  -< 3 = 'Low Risk'
 351       +        3    -< 5 = 'Medium Risk'
 352       +        5    -< 7 = 'High Risk'
 353       +        7 - high  = 'Very High Risk';
 NOTE: Format RISK_SCORE has been output.
