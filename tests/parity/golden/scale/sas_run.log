 333       +/*******************************************************************************/
 334       +
 335       +/* Step 1: Define risk bucket formats using PROC FORMAT */
 336       +proc format;
 337       +    /* LTV Risk Categories */
 338       +    value ltv_risk
 339       +        low  -< 0.60 = 'Low'
 340       +        0.60 -< 0.80 = 'Medium'
 341       +        0.80 - high   = 'High';
 NOTE: Format LTV_RISK has been output.
 342       +
 343       +    /* Debt-to-Income Risk Categories */
 344       +    value dti_risk
 345       +        low  -< 30  = 'Low'
 346       +        30   -< 40  = 'Medium'
 347       +        40   -< 50  = 'High'
 348       +        50   - high  = 'Very High';
 NOTE: Format DTI_RISK has been output.
 349       +
 350       +    /* Delinquency Risk Categories */
 351       +    value delinq_risk
 352       +        0         = 'None'
 353       +        1         = 'Low'
 354       +        2 - 3     = 'Medium'
 355       +        4 - high  = 'High';
 NOTE: Format DELINQ_RISK has been output.
 356       +
 357       +    /* Combined Risk Score Categories */
 358       +    value risk_score
 359       +        low  -< 3 = 'Low Risk'
 360       +        3    -< 5 = 'Medium Risk'
 361       +        5    -< 7 = 'High Risk'
 362       +        7 - high  = 'Very High Risk';
 NOTE: Format RISK_SCORE has been output.
