 189       +/*  - Filter records and check for outliers                                  */
 190       +/*******************************************************************************/
 191       +
 192       +/* Step 1: Create derived columns using DATA step */
 193       +data work.home_equity_clean;
 194       +    length LOAN_OUTCOME $ 7;
 195       +    set work.home_equity;
 196       +
 197       +    /* Calculate Loan-to-Value ratio */
 198       +    if VALUE ne . and MORTDUE ne . and VALUE > 0 then
 199       +        LTV = MORTDUE / VALUE;
 200       +    else
 201       +        LTV = .;
 202       +
 203       +    /* Create descriptive loan outcome */
 204       +    if BAD = 0 then LOAN_OUTCOME = 'Paid';
 205       +    else if BAD = 1 then LOAN_OUTCOME = 'Default';
 206       +    else LOAN_OUTCOME = '';
 207       +
 208       +    /* Proper-case city names */
 209       +    CITY = propcase(CITY);
 210       +
 211       +    /* Apply labels */
 212       +    label LTV = "Loan to Value Ratio"
 213       +          LOAN_OUTCOME = "Loan Outcome";
 214       +    format LTV percent8.2;
 215       +run;
 
