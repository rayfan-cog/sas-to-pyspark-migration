 379       +    if DEBTINC ne . then do;
 380       +        if DEBTINC < 30 then DTI_RISK_CAT = 'Low';
 381       +        else if DEBTINC < 40 then DTI_RISK_CAT = 'Medium';
 382       +        else if DEBTINC < 50 then DTI_RISK_CAT = 'High';
 383       +        else DTI_RISK_CAT = 'Very High';
 384       +    end;
 385       +
 386       +    /* Delinquency risk category */
 387       +    if DELINQ ne . then do;
 388       +        if DELINQ = 0 then DELINQ_RISK_CAT = 'None';
 389       +        else if DELINQ = 1 then DELINQ_RISK_CAT = 'Low';
 390       +        else if DELINQ <= 3 then DELINQ_RISK_CAT = 'Medium';
 391       +        else DELINQ_RISK_CAT = 'High';
 392       +    end;
 393       +
 394       +    /* Composite risk score (0-10 scale) */
 395       +    RISK_SCORE = 0;
 396       +
 397       +    /* LTV component (0-3 points) */
 398       +    if LTV ne . then do;
 399       +        if LTV >= 0.80 then RISK_SCORE = RISK_SCORE + 3;
 400       +        else if LTV >= 0.60 then RISK_SCORE = RISK_SCORE + 1.5;
 401       +    end;
 402       +
 403       +    /* DTI component (0-3 points) */
 404       +    if DEBTINC ne . then do;
 405       +        if DEBTINC >= 50 then RISK_SCORE = RISK_SCORE + 3;
 406       +        else if DEBTINC >= 40 then RISK_SCORE = RISK_SCORE + 2;
 407       +        else if DEBTINC >= 30 then RISK_SCORE = RISK_SCORE + 1;
 408       +    end;
 409       +
 410       +    /* Delinquency component (0-2 points) */
 411       +    if DELINQ ne . then do;
 412       +        if DELINQ >= 4 then RISK_SCORE = RISK_SCORE + 2;
 413       +        else if DELINQ >= 2 then RISK_SCORE = RISK_SCORE + 1.5;
 414       +        else if DELINQ = 1 then RISK_SCORE = RISK_SCORE + 0.5;
 415       +    end;
 416       +
 417       +    /* Derogatory reports component (0-2 points) */
 418       +    if DEROG ne . then do;
 419       +        if DEROG >= 3 then RISK_SCORE = RISK_SCORE + 2;
 420       +        else if DEROG >= 1 then RISK_SCORE = RISK_SCORE + 1;
 421       +    end;
 422       +
 423       +    /* Risk score category */
 424       +    length RISK_SEGMENT $14;
 425       +    if RISK_SCORE < 3 then RISK_SEGMENT = 'Low Risk';
 426       +    else if RISK_SCORE < 5 then RISK_SEGMENT = 'Medium Risk';
 427       +    else if RISK_SCORE < 7 then RISK_SEGMENT = 'High Risk';
 428       +    else RISK_SEGMENT = 'Very High Risk';
 429       +
 430       +    label LTV_RISK_CAT = "LTV Risk Category"
 431       +          DTI_RISK_CAT = "Debt-to-Income Risk Category"
 432       +          DELINQ_RISK_CAT = "Delinquency Risk Category"
 433       +          RISK_SCORE = "Composite Risk Score (0-10)"
 434       +          RISK_SEGMENT = "Risk Segment";
 435       +run;
 
